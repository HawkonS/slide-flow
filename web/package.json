{
  "name": "slide-flow-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "test:resources": "node --test tests/api-errors.mjs tests/resource-loading-browser.mjs tests/tag-defaults.mjs",
    "test:tag-defaults": "node --test tests/tag-defaults.mjs",
    "test:pwa:install": "playwright install chromium",
    "test:pwa:unit": "node --test tests/api-errors.mjs tests/download-manager.mjs tests/offline-session.mjs tests/playback-assets.mjs ../tests/test_pwa_service_worker.mjs",
    "test:pwa:browser": "node --test --test-concurrency=1 tests/offline-auth.mjs tests/playback-browser.mjs tests/playback-integration.mjs tests/offline-cache-ui.mjs tests/product-review-browser.mjs tests/resource-import-wizard.mjs tests/resource-loading-browser.mjs tests/tag-defaults.mjs ../tests/test_pwa_browser.mjs",
    "test:pwa:ui": "node --test tests/offline-cache-ui.mjs",
    "test:pwa": "npm run test:pwa:unit && npm run build && npm run test:pwa:browser"
  },
  "dependencies": {
    "@hookform/resolvers": "^7.0.6",
    "@radix-ui/react-checkbox": "^1.4.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-separator": "^1.2.0",
    "@radix-ui/react-slot": "^1.1.0",
    "@radix-ui/react-switch": "^1.4.1",
    "@radix-ui/react-tabs": "^1.2.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@tanstack/react-query": "^5.107.1",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "cmdk": "^1.0.0",
    "lucide-react": "^1.72.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.92.0",
    "react-router-dom": "^7.18.5",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^4.6.7",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "autoprefixer": "^10.6.2",
    "playwright": "1.65.0",
    "postcss": "^8.5.32",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  }
}
